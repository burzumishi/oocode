{
  "name": "oocode",
  "displayName": "OOCode",
  "description": "Extensión para OOCode — CLI de asistencia de código local con Ollama",
  "version": "1.1.0",
  "publisher": "burzumishi",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": ["Other", "Machine Learning"],
  "icon": "icon.png",
  "activationEvents": [
    "onCommand:ooCode.status",
    "onCommand:ooCode.ask",
    "onCommand:ooCode.models.list",
    "onCommand:ooCode.models.select",
    "onCommand:ooCode.hooks.list",
    "onCommand:ooCode.hooks.enable",
    "onCommand:ooCode.hooks.disable",
    "onCommand:ooCode.plugins.list",
    "onCommand:ooCode.plugins.enable",
    "onCommand:ooCode.plugins.disable",
    "onCommand:ooCode.subagents.list",
    "onCommand:ooCode.subagents.spawn",
    "onCommand:ooCode.subagents.kill",
    "onCommand:ooCode.webserver.status",
    "onCommand:ooCode.webserver.start",
    "onCommand:ooCode.webserver.stop",
    "onCommand:ooCode.commands.list",
    "onCommand:ooCode.help"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "ooCode.status",           "title": "OOCode: Estado del agente" },
      { "command": "ooCode.ask",              "title": "OOCode: Preguntar al agente" },
      { "command": "ooCode.models.list",      "title": "OOCode: Listar modelos" },
      { "command": "ooCode.models.select",    "title": "OOCode: Seleccionar modelo" },
      { "command": "ooCode.hooks.list",       "title": "OOCode: Listar hooks" },
      { "command": "ooCode.hooks.enable",     "title": "OOCode: Activar hook" },
      { "command": "ooCode.hooks.disable",    "title": "OOCode: Desactivar hook" },
      { "command": "ooCode.plugins.list",     "title": "OOCode: Listar plugins" },
      { "command": "ooCode.plugins.enable",   "title": "OOCode: Activar plugin" },
      { "command": "ooCode.plugins.disable",  "title": "OOCode: Desactivar plugin" },
      { "command": "ooCode.subagents.list",   "title": "OOCode: Listar subagentes" },
      { "command": "ooCode.subagents.spawn",  "title": "OOCode: Lanzar subagente" },
      { "command": "ooCode.subagents.kill",   "title": "OOCode: Detener subagente" },
      { "command": "ooCode.webserver.status", "title": "OOCode WebUI: Estado" },
      { "command": "ooCode.webserver.start",  "title": "OOCode WebUI: Iniciar daemon" },
      { "command": "ooCode.webserver.stop",   "title": "OOCode WebUI: Parar daemon" },
      { "command": "ooCode.commands.list",    "title": "OOCode: Listar comandos" },
      { "command": "ooCode.help",             "title": "OOCode: Ayuda" }
    ],
    "configuration": {
      "title": "OOCode",
      "properties": {
        "oocode.host": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "URL del WebUI de OOCode (ej: http://192.168.1.100:4000)"
        },
        "oocode.agent": {
          "type": "string",
          "default": "main",
          "description": "ID del agente activo (main, coding, reasoning, office, webcrawler)"
        }
      }
    },
    "keybindings": [
      {
        "command": "ooCode.ask",
        "key":     "ctrl+shift+o",
        "mac":     "cmd+shift+o",
        "when":    "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ooCode.ask",
          "group":   "oocode@1",
          "when":    "editorTextFocus"
        }
      ],
      "commandPalette": [
        { "command": "ooCode.status" },
        { "command": "ooCode.ask" },
        { "command": "ooCode.models.list" },
        { "command": "ooCode.models.select" },
        { "command": "ooCode.hooks.list" },
        { "command": "ooCode.subagents.list" },
        { "command": "ooCode.subagents.spawn" },
        { "command": "ooCode.webserver.status" },
        { "command": "ooCode.webserver.start" },
        { "command": "ooCode.webserver.stop" },
        { "command": "ooCode.commands.list" },
        { "command": "ooCode.help" }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "keywords": ["ollama", "ai", "local", "cli", "assistant", "code", "llm"],
  "author": "burzumishi",
  "license": "MIT"
}
