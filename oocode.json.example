    "lsp": {
      "requestTimeout": 10.0,
      "serverCmds": {},
      "autoStart": [
        ".py",
        ".js",
        ".ts",
        ".go",
        ".rs",
        ".c",
        ".cpp",
        ".rb",
        ".sh",
