  "hooks": {
    "enabled": true,
    "builtins": [
      "diff_after_write",
      "ctags_after_write",
      "lint_after_write",
      "quick_syntax_after_write",
      "lsp_after_write",
      "verify_after_edit",
      "test_suite_delta",
      "interface_change_detector",
      "config_syntax_after_write",
      "git_push_guard",
      "backup_before_write",
      "log_tool_calls",
      "test_after_write",
      "doc_validate_template_filled",
      "deadlock_detection",
      "dead_code_detection",
      "performance_profiling"
    ]
  },
  "snapshots": {
    "enabled": true,
    "maxSnapshots": 40,
    "saveOnCompact": true
  },
  "rag": {
    "enabled": true,
    "topK": 15,
    "similarityThreshold": 0.38,
    "maxSnippetChars": 20000,
    "indexInterval": 300.0,
    "topKComplex": 30,
    "thresholdComplex": 0.3,
    "complexMinChars": 150,
    "maxFileChars": 6000,
    "chunkChars": 512,
    "chunkOverlap": 64,
    "maxFiles": 2000,
    "minSlotChars": 200
  },
  "vision": {
    "enabled": true,
    "showIndicator": true
  },
  "chatlog": {
    "enabled": true,
    "path": "~/.oocode/logs/chat.log",
    "maxSizeMb": 10
  },
  "webui": {
    "enabled": false,
    "host": "0.0.0.0",
    "port": 4000,
    "logFile": "~/.oocode/logs/webui.log",
    "logMaxSizeMb": 5
  },
  "subagents": {
    "maxConcurrent": 2,
    "maxTeams": 1,
    "maxTeamSize": 2,
    "recentTtl": 1800,
    "defaultPriority": 0,
    "autoContMax": 16,
    "inferenceTimeout": 0,
    "defaultTimeout": 600
  },
  "backup": {
    "enabled": true,
    "dir": "~/.oocode/backup",
    "maxFiles": 50,
    "extensions": [
      ".py",
      ".js",
      ".ts",
      ".jsx",
      ".tsx",
      ".go",
      ".rs",
      ".c",
      ".cpp",
      ".h",
      ".hpp",
      ".java",
      ".rb",
      ".php",
      ".cs",
      ".sh",
      ".bash",
      ".pl",
      ".pm",
      ".sql",
      ".md",
      ".txt",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".html",
      ".css"
    ]
  }
}