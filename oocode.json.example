  "context": {
    "minKeep": 12,
    "compactThreshold": 0.82,
    "maxSummaryChars": 20000,
    "maxToolResultTokens": 16000,
    "autoContinueMax": 12,
    "cache_dir": "~/.oocode/cache",
    "prompt_cache_enabled": true,
    "prompt_cache_ttl": 3600,
    "context_window_configurable": true,
    "context_window_default": 131072,
    "context_window_min": 8192,
    "context_window_max": 131072,
    "highWater": 0.7,
    "toolMaxChars": 3000,
    "ctxMode": "full"
  },
  "embeddings": {
    "model": "nomic-embed-text-v2-moe:latest",
    "maxInputChars": 6000,
    "similarityThreshold": 0.3,
    "snippetChars": 600,
    "topK": 8,
    "memoryEmbedEnabled": true,
    "diskCacheEnabled": true,
    "diskCacheDir": "~/.oocode/cache",
    "diskCacheMaxEntries": 2000,
    "ramCacheMax": 256
  },
  "tools": {
    "readFileLinesDefault": 8000,
    "readFileLinesWarnLarge": 15000,
    "webFetchMaxChars": 100000,
    "webFetchTimeout": 20,
    "webSearchMaxResults": 10,
    "bashMaxOutputChars": 800000,
    "codeSearchMaxResults": 400,
    "codeSearchContextLines": 2000,
    "codeSearchMaxFilesize": "2M",
    "toolCacheEnabled": true,
    "toolCacheMaxSize": 2400,
    "mcpMaxOutputChars": 4000
  },
  "workspace": {
    "maxMemoryLines": 800,
    "maxDailyChars": 20000
  },
  "searxng": {
    "url": "http://192.168.1.33:8888",
    "enabled": true,
    "maxResults": 8,
    "categories": "general",
    "language": "auto",
    "safeSearch": 0,
    "timeout": 30
  },
  "logging": {
    "enabled": true,
    "file": "~/.oocode/logs/oocode.log",
    "level": "info",
    "maxSizeMb": 5,
    "maxFiles": 3
  },
  "plugins": {
    "enabled": [
      "changelog",
      "clipboard",
      "embeddings_search",
      "lsp",
      "searxng",
      "test_runner",
      "todo",
      "tree_sitter",
